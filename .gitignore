# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Cloudflare local state
.wrangler/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Track migrations even when a global Git ignore excludes SQL files.
!supabase/migrations/**/*.sql
!supabase/tests/**/*.sql

# Secrets - never commit these.
# Copy the .example files and fill in your own values.
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.local

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.nova/*
!.nova/Configuration.json
!.nova/Tasks/
.idea/

# Logs
*.log
npm-debug.log*

# Test output
coverage/

# Paid fonts - the full fonts are not in the repo. fonts-encrypted/ and
# client/public/fonts/*.enc are locked copies (see scripts/fonts.mjs); any
# plain font file in client/public/fonts/ stays out.
fonts-source/
client/public/fonts/*
!client/public/fonts/*.enc
