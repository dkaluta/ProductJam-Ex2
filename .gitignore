# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Cloudflare local state
.wrangler/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Track migrations even when a global Git ignore excludes SQL files.
!supabase/migrations/**/*.sql
!supabase/tests/**/*.sql

# Secrets - never commit these.
# Copy the .example files and fill in your own values.
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.local

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.nova/*
!.nova/Configuration.json
!.nova/Tasks/
.idea/

# Logs
*.log
npm-debug.log*

# Test output
coverage/

# Paid fonts - licensed, so only encrypted copies are in the repo, in
# fonts-encrypted/. `npm run build` unlocks them with FONTS_KEY (see
# scripts/fonts.mjs).
client/public/fonts/
