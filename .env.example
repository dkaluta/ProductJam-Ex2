# Copy to .env and fill in:  cp .env.example .env
# Guide: docs/02-supabase-setup.md. Deploying: docs/04-deploy.md.

# --- PUBLIC: VITE_ values are shipped to every visitor's browser ---

# Project Settings -> Data API -> URL (delete the /rest/v1/ at the end)
VITE_SUPABASE_URL=
# API Keys -> publishable (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to false before handing the app over
VITE_SHOW_DEMOS=true

# --- PRIVATE: server only. NEVER add VITE_ to these ---

# Leave this line alone - it copies the URL from above
SUPABASE_URL=${VITE_SUPABASE_URL}
# API Keys -> secret (sb_secret_...). It's a password: never put it in client/
SUPABASE_SECRET_KEY=

# NASA and Gemini are called only by the Worker. Never use a VITE_ prefix.
NASA_API_KEY=
GEMINI_API_KEY=
# Choose a currently available text model ID from Google AI Studio.
GEMINI_MODEL=

# Unlocks the paid fonts (see scripts/fonts.mjs). Ask whoever set them up.
# On Cloudflare it is a runtime secret on the Worker (Settings -> Variables
# and Secrets), which the Worker uses to unlock each font as it is served.
FONTS_KEY=
